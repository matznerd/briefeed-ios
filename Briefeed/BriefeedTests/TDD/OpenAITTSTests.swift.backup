// MARK: - Performance Tests

@MainActor
final class OpenAITTSPerformanceTests: XCTestCase {
    
    var sut: OpenAITTSService!
    
    override func setUp() async throws {
        try await super.setUp()
        sut = OpenAITTSService.shared
        UserDefaultsManager.shared.openAIAPIKey = "test-key"
    }
    
    func testCostCalculation_Performance() {
        measure {
            // Given
            let testText = String(repeating: "a", count: 10000)
            
            // When/Then
            for _ in 0..<100 {
                _ = sut.getEstimatedCost()
            }
        }
    }
    
    func testVoiceSelection_Performance() {
        measure {
            // Given
            let profile = NewsVoiceProfile()
            let texts = [
                "Short headline",
                String(repeating: "Summary text. ", count: 30),
                "The speaker said \"This is a quote\" yesterday",
                String(repeating: "Long article. ", count: 100)
            ]
            
            // When/Then
            for text in texts {
                _ = NewsVoiceProfile.ContentType.detect(from: text)
                _ = profile.instructions(for: NewsVoiceProfile.ContentType.detect(from: text))
            }
        }
    }
}