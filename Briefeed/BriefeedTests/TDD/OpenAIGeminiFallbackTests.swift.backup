//
//  OpenAIGeminiFallbackTests.swift
//  BriefeedTests
//
//  Integration tests for OpenAI/Gemini TTS fallback behavior
//

import XCTest
import AVFoundation
import Combine
@testable import Briefeed

@MainActor
final class OpenAIGeminiFallbackTests: XCTestCase {
    
    var unifiedPlayer: UnifiedAudioPlayer!
    var cancellables: Set<AnyCancellable>!
    var context: NSManagedObjectContext!
    
    override func setUp() async throws {
        try await super.setUp()
        
        cancellables = Set<AnyCancellable>()
        context = PersistenceController.preview.container.viewContext
        unifiedPlayer = UnifiedAudioPlayer.shared
        
        // Reset for clean state
        unifiedPlayer.clearQueue()
        UserDefaultsManager.shared.openAIAPIKey = nil
        UserDefaultsManager.shared.useOpenAIStreaming = false
    }
    
    override func tearDown() async throws {
        cancellables = nil
        unifiedPlayer.clearQueue()
        UserDefaultsManager.shared.openAIAPIKey = nil
        try await super.tearDown()
    }
    
    // MARK: - Fallback Logic Tests
    
    func testTTSFallback_WhenOpenAIKeyNotSet_UsesGeminiDirectly() async {
        // Given
        UserDefaultsManager.shared.openAIAPIKey = nil
        let article = createTestArticle(withSummary: "Test summary for Gemini")
        
        // When
        await unifiedPlayer.loadQueue(from: [article])
        
        // Then
        XCTAssertEqual(unifiedPlayer.queue.count, 1)
        XCTAssertNil(UserDefaultsManager.shared.openAIAPIKey)
        // In production, would verify Gemini service was called
    }
    
    func testTTSFallback_WhenOpenAIKeyEmpty_UsesGemini() async {
        // Given
        UserDefaultsManager.shared.openAIAPIKey = ""
        let article = createTestArticle(withSummary: "Test summary")
        
        // When
        await unifiedPlayer.loadQueue(from: [article])
        
        // Then
        XCTAssertEqual(unifiedPlayer.queue.count, 1)
        // Empty key should be treated as no key
    }
    
    func testTTSFallback_WhenOpenAIConfigured_TriesOpenAIFirst() async {
        // Given
        UserDefaultsManager.shared.openAIAPIKey = "sk-test-key"
        let article = createTestArticle(withSummary: "Test summary for OpenAI")
        
        // When
        await unifiedPlayer.loadQueue(from: [article])
        
        // Then
        XCTAssertEqual(unifiedPlayer.queue.count, 1)
        XCTAssertNotNil(UserDefaultsManager.shared.openAIAPIKey)
        // Would verify OpenAI was attempted first
    }
    
    // MARK: - Queue Item State Tests
    
    func testQueueItem_StartsInPendingState() {
        // Given
        let article = createTestArticle(withSummary: "Test")
        
        // When
        let queueItem = UnifiedQueueItem(article: article)
        
        // Then
        XCTAssertEqual(queueItem.generationState, .pending)
        XCTAssertNil(queueItem.cachedAudioURL)
    }
    
    func testQueueItem_TransitionsToGeneratingDuringTTS() async {
        // Given
        let article = createTestArticle(withSummary: "Test summary")
        let queueItem = UnifiedQueueItem(article: article)
        
        var stateChanges: [UnifiedQueueItem.GenerationState] = []
        
        queueItem.$generationState
            .sink { state in
                stateChanges.append(state)
            }
            .store(in: &cancellables)
        
        // When
        await unifiedPlayer.loadQueue(from: [article])
        
        // Allow some time for state changes
        try? await Task.sleep(nanoseconds: 100_000_000) // 0.1 seconds
        
        // Then
        XCTAssertTrue(stateChanges.contains(.pending))
        // Would also contain .generating if we could mock the service
    }
    
    // MARK: - Content Formatting Tests
    
    func testContentFormatting_IncludesTitleAndSummary() {
        // Given
        let title = "Breaking News"
        let summary = "This is the article summary"
        let article = createTestArticle(title: title, summary: summary)
        
        // When
        let queueItem = UnifiedQueueItem(article: article)
        
        // Then
        XCTAssertEqual(queueItem.title, title)
        XCTAssertEqual(queueItem.content, summary)
    }
    
    func testContentFormatting_FallsBackToContentWhenNoSummary() {
        // Given
        let title = "Article Title"
        let content = "Article content without summary"
        let article = createTestArticle(title: title, summary: nil, content: content)
        
        // When
        let queueItem = UnifiedQueueItem(article: article)
        
        // Then
        XCTAssertEqual(queueItem.title, title)
        XCTAssertEqual(queueItem.content, content)
    }
    
    // MARK: - Streaming Configuration Tests
    
    func testStreaming_EnabledWhenConfigured() {
        // Given/When
        UserDefaultsManager.shared.useOpenAIStreaming = true
        
        // Then
        XCTAssertTrue(UserDefaultsManager.shared.useOpenAIStreaming)
    }
    
    func testStreaming_DisabledByDefault() {
        // Given
        UserDefaults.standard.removeObject(forKey: "useOpenAIStreaming")
        
        // When/Then
        XCTAssertFalse(UserDefaultsManager.shared.useOpenAIStreaming)
    }
    
    // MARK: - Error Recovery Tests
    
    func testErrorRecovery_ContinuesProcessingAfterFailure() async {
        // Given
        let articles = [
            createTestArticle(withSummary: "First article"),
            createTestArticle(withSummary: nil), // This might fail
            createTestArticle(withSummary: "Third article")
        ]
        
        // When
        await unifiedPlayer.loadQueue(from: articles)
        
        // Then
        XCTAssertEqual(unifiedPlayer.queue.count, 3)
        // All items should be in queue even if some fail generation
    }
    
    // MARK: - Cost Awareness Tests
    
    func testCostTracking_IsAccessibleAfterGeneration() {
        // Given
        let openAIService = OpenAITTSService.shared
        openAIService.resetCostTracking()
        
        // When
        let initialCost = openAIService.getEstimatedCost()
        
        // Then
        XCTAssertEqual(initialCost, 0.0)
    }
    
    // MARK: - Voice Selection Tests
    
    func testVoiceSelection_RespectsuserPreference() {
        // Given
        let preferredVoice = OpenAIVoice.sage
        
        // When
        UserDefaultsManager.shared.preferredOpenAIVoice = preferredVoice
        
        // Then
        XCTAssertEqual(UserDefaultsManager.shared.preferredOpenAIVoice, preferredVoice)
    }
    
    func testVoiceSelection_DefaultsToNewsOptimizedVoice() {
        // Given
        UserDefaults.standard.removeObject(forKey: "preferredOpenAIVoice")
        
        // When
        let defaultVoice = UserDefaultsManager.shared.preferredOpenAIVoice
        
        // Then
        XCTAssertEqual(defaultVoice, .coral)
        XCTAssertTrue(defaultVoice.isRecommendedForNews)
    }
    
    // MARK: - Pre-generation Tests
    
    func testPreGeneration_ProcessesNextItemsInQueue() async {
        // Given
        let articles = (1...5).map { index in
            createTestArticle(withSummary: "Article \(index)")
        }
        
        // When
        await unifiedPlayer.loadQueue(from: articles)
        
        // Allow pre-generation to start
        try? await Task.sleep(nanoseconds: 100_000_000)
        
        // Then
        XCTAssertEqual(unifiedPlayer.queue.count, 5)
        // First 3 items would be marked for pre-generation
    }
    
    // MARK: - Helper Methods
    
    private func createTestArticle(
        title: String = "Test Article",
        summary: String? = nil,
        content: String = "Test content"
    ) -> Article {
        let article = Article(context: context)
        article.id = UUID()
        article.title = title
        article.summary = summary
        article.content = content
        article.url = "https://example.com/\(UUID().uuidString)"
        article.publishedDate = Date()
        return article
    }
    
    private func createTestArticle(withSummary summary: String) -> Article {
        createTestArticle(summary: summary)
    }
}

