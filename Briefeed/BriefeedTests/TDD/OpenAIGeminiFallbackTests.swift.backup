// MARK: - Migration Path Tests

@MainActor
final class TTSMigrationTests: XCTestCase {
    
    func testMigration_Phase1_DualService() {
        // Test Phase 1: Both services available
        
        // Given
        let hasOpenAI = UserDefaultsManager.shared.openAIAPIKey != nil
        let hasGemini = true // Always available as fallback
        
        // Then
        XCTAssertTrue(hasGemini, "Gemini should remain as fallback")
    }
    
    func testMigration_Phase2_OpenAIPrimary() {
        // Test Phase 2: OpenAI as primary when configured
        
        // Given
        UserDefaultsManager.shared.openAIAPIKey = "sk-test"
        
        // When
        let hasOpenAIKey = UserDefaultsManager.shared.openAIAPIKey != nil
        
        // Then
        XCTAssertTrue(hasOpenAIKey, "OpenAI should be primary when key exists")
    }
    
    func testMigration_BackwardCompatibility() async {
        // Test that existing queue items still work
        
        // Given
        let context = PersistenceController.preview.container.viewContext
        let article = Article(context: context)
        article.id = UUID()
        article.title = "Legacy Article"
        article.summary = "Legacy summary"
        
        // When
        let queueItem = UnifiedQueueItem(article: article)
        
        // Then
        XCTAssertNotNil(queueItem)
        XCTAssertEqual(queueItem.title, "Legacy Article")
        // Existing articles should work with new TTS system
    }
}